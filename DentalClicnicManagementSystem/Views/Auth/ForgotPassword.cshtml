@model CMS.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = "_AuthLayout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card mt-5 shadow-sm">
            <div class="card-body">
                <h2 class="text-center mb-4">Forgot Password</h2>
                <p class="text-center text-muted">Enter your email address to reset your password.</p>
                <form asp-action="ForgotPassword" method="post" id="forgotPasswordForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="form-group mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="Enter your email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                    <div class="d-grid">
                        <button type="submit" id="submitBtn" class="btn btn-primary">Send Reset Link</button>
                    </div>
                </form>
                <div class="text-center mt-3">
                    <a asp-action="Login">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function () {
            $('#forgotPasswordForm').on('submit', function () {
                if ($(this).valid()) {
                    var btn = $('#submitBtn');
                    btn.prop('disabled', true);
                    btn.text('Check email');
                }
            });
        });
    </script>
}
