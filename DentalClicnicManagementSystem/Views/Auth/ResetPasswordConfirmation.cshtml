@{
    ViewData["Title"] = "Reset Password Confirmation";
    Layout = "_AuthLayout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card mt-5 shadow-sm">
            <div class="card-body text-center">
                <h2 class="mb-4">Password Reset</h2>
                <p>
                    Your password has been reset. Please <a asp-action="Login">click here to log in</a> with your new password.
                </p>
                <div class="mt-4">
                    <a asp-action="Login" class="btn btn-primary">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</div>
