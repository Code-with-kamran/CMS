@model CMS.ViewModels.PublicAppointmentVM
@{
    ViewData["Title"] = "Prendre Rendez-vous";
    Layout = null;
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="shortcut icon" href="~/assets/img/CABINET-DENTAIRE-CORVIL.png">
    <link rel="stylesheet" href="~/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/assets/plugins/fontawesome/css/fontawesome.min.css">
    <link rel="stylesheet" href="~/assets/plugins/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="~/assets/css/style.css" id="app-style">

    <style>
        body {
            font-family: 'Segoe UI', sans-serif;
            background-color: #f4f6fa;
        }

        .appointment-container {
            display: flex;
            min-height: 100vh;
            background-color: white;
        }

        .left-panel {
            flex: 1;
            min-height: 100%;
        }

        .right-panel {
            flex: 1;
            padding: 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-title {
            font-size: 28px;
            font-weight: bold;
        }

        .form-subtitle {
            font-size: 14px;
            color: #666;
            margin-bottom: 25px;
        }

        .form-control, .form-select {
            border-radius: 10px;
        }

        .submit-btn {
            border-radius: 10px;
            padding: 10px 25px;
        }

        @@media (max-width: 768px) {
            .appointment-container {
                flex-direction: column;
            }

            .left-panel {
                height: 250px;
            }

            .right-panel {
                padding: 30px 20px;
            }
        }
    </style>
</head>

<body>
    <div class="appointment-container">
        <!-- Illustration côté gauche -->
        <div class="col-12 col-md-4 d-flex justify-content-center align-items-center mx-auto mb-3 mb-md-0">
            <img src="~/assets/img/CABINET-DENTAIRE-CORVIL.png"
                 alt="Logo"
                 class="img-fluid w-75" />
        </div>

        <!-- Formulaire côté droit -->
        <div class="right-panel">
            <h2 class="form-title">Planifiez Votre Rendez-vous avec des Experts de Confiance</h2>
            <p class="form-subtitle">Nous avons les meilleurs spécialistes de votre région. Qualité, garantie et professionnalisme sont notre slogan !</p>

            <div id="alertBox"></div>

            <form id="bookForm">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <!-- Nom Complet -->
                    <div class="col-md-6">
                        <label asp-for="FullName" class="form-label">Nom Complet</label>
                        <input asp-for="FullName" class="form-control" placeholder="Votre nom complet" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label" for="SelectedDomain">Lieu du Rendez-vous</label>
                        <select asp-for="SelectedDomain" class="form-select" required>
                            <option value="PortAuPrince">Port-au-Prince</option>
                            <option value="CapHaitien">Cap-Haïtien</option>
                            <option value="Gonaves">Gonaïves</option>
                        </select>
                        <span asp-validation-for="SelectedDomain" class="text-danger"></span>
                    </div>

                    <!-- Spécialisation -->
                    <div class="col-md-6">
                        <label asp-for="PreferredSpecialization" class="form-label">Spécialisation Préférée</label>
                        <select asp-for="PreferredSpecialization" asp-items="Model.SpecializationOptions" class="form-select">
                            <option value="">--Sélectionnez une spécialisation--</option>
                        </select>
                        <span asp-validation-for="PreferredSpecialization" class="text-danger"></span>
                    </div>

                    <!-- Date -->
                    <div class="col-md-6">
                        <label asp-for="PreferredDate" class="form-label">Date Préférée</label>
                        <input asp-for="PreferredDate" type="date" class="form-control" min="@today" />
                        <span asp-validation-for="PreferredDate" class="text-danger"></span>
                    </div>

                    <!-- Heure -->
                    <div class="col-md-6">
                        <label asp-for="PreferredTime" class="form-label">Heure Préférée</label>
                        <input asp-for="PreferredTime" type="time" class="form-control" />
                        <span asp-validation-for="PreferredTime" class="text-danger"></span>
                    </div>

                    <!-- Email -->
                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label">Adresse Email</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="Adresse email" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- Téléphone -->
                    <div class="col-md-6">
                        <label asp-for="PhoneNumber" class="form-label">Numéro de Téléphone</label>
                        <input asp-for="PhoneNumber" type="tel" class="form-control" placeholder="Numéro de téléphone" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>

                    <!-- Genre -->
                    <div class="col-md-6">
                        <label asp-for="Gender" class="form-label">Genre</label>
                        <select asp-for="Gender" asp-items="Model.GenderOptions" class="form-select">
                            <option value="">Sélectionner le genre</option>
                        </select>
                        <span asp-validation-for="Gender" class="text-danger"></span>
                    </div>

                    <!-- Date de Naissance -->
                    <div class="col-md-6">
                        <label asp-for="DateOfBirth" class="form-label">Date de Naissance</label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" max="@today" />
                        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                    </div>

                    <!-- Adresse -->
                    <div class="col-md-6">
                        <label asp-for="Address" class="form-label">Adresse</label>
                        <input asp-for="Address" class="form-control" placeholder="Adresse" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>

                    <!-- Notes -->
                    <div class="col-12">
                        <label asp-for="Notes" class="form-label">Message / Notes</label>
                        <textarea asp-for="Notes" rows="3" class="form-control" placeholder="Veuillez décrire votre problème"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <!-- Submit -->
                    <div class="col-12 mt-3 d-flex justify-content-between align-items-center">
                        <button type="submit" class="btn btn-primary submit-btn">Réserver Maintenant</button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/js/bootstrap.bundle.min.js"></script>
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            $('#bookForm').on('submit', function (e) {
                e.preventDefault();
                var form = $(this);
                var data = form.serialize();

                $('#alertBox').html('<div class="alert alert-info">Envoi en cours...</div>');

                $.ajax({
                    url: '/PublicAppointments/SubmitAppointmentAjax',
                    type: 'POST',
                    data: data,
                    success: function (response) {
                        if (response.success) {
                            $('#alertBox').html('<div class="alert alert-success">' + response.message + '</div>');
                            form.trigger('reset');
                        } else {
                            $('#alertBox').html('<div class="alert alert-danger">' + response.message + '</div>');
                        }
                    },
                    error: function (xhr) {
                        $('#alertBox').html('<div class="alert alert-danger">Erreur serveur: ' + xhr.statusText + '</div>');
                    }
                });
            });
        });
    </script>
</body>
</html>
